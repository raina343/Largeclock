  uint8_t ang[MAX_LEDS];                // angle around its character's centre, 0-255
  uint8_t rad[MAX_LEDS];                // distance from its character's centre, 0-255
  uint8_t gang[MAX_LEDS];               // angle around the middle of the whole display, 0-255
  int     numSlots;
