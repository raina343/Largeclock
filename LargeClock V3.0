// ================= PINS (all of them, in one place) =================
// LED data lines (WS2812B)
#define PIN_TIME_A        10      // top time display (main timezone)
#define PIN_TIME_B        1       // bottom time display (second timezone)
#define PIN_DATE          2       // date display
#define PIN_DAY           13      // day-of-week display
// DS3231 real-time clock: SDA = 11, SCL = 12 (the board's fixed I2C pins, nothing to set here)
#define CLOCK_INTERRUPT_PIN 0     // DS3231 INT/SQW (open drain, active low): minute and :55 alarms
// Sensors
#define LIGHT_SENSOR_PIN  A0      // light sensor for auto-dimming
#define DS18B20_PIN       8       // DS18B20 data wire (needs a 4.7k pull-up to 3.3V); -1 = no probe fitted
// Buttons and wiring
#define RESET_BUTTON_PIN  14      // reset-settings button, wired between this pin and GND
#define RESET_WIRE_PIN    7       // wired straight to the board's RESET line: never drive this pin

#if DS18B20_PIN == RESET_WIRE_PIN
#error "DS18B20_PIN can't be the pin wired to RESET: the probe's signalling would restart the board"
#endif
#if DS18B20_PIN == RESET_BUTTON_PIN
#error "DS18B20_PIN can't be the reset button's pin"
#endif

// ---------------- Display hardware ----------------
#define ROTATED_TIME_A    true    // mounted upside down
#define ROTATED_TIME_B    false
#define ROTATED_DATE      false
#define ROTATED_DAY       false

// ---------------- Effect fine-tuning ----------------
#define BLINK_COLON       false   // true = time colon blinks once a second, false = always on
#define HOUR_SHOW         true    // rainbow + sparkle on the hour
#define FADE_MS           400     // how long a changing segment takes to fade
#define TRANS_SIDE_BY_SIDE false   // Trans style: false = stripes top to bottom, true = left to right
#define TRANS_GRADIENT     true    // Trans style: true = colours blend smoothly, false = solid stripes
#define FLIP_FIRE_TIME_A  true    // Fire + Matrix rain: true = flip up/down on that display
#define FLIP_FIRE_TIME_B  false
#define FLIP_FIRE_DATE    true
#define FLIP_FIRE_DAY     true
#define SPIN_MS           3000    // Spinning rainbow: ms per full turn
#define SPIN_OFFSET       0       // Spinning rainbow: 0 = all characters in step, try 40 to stagger them
#define GHOST             0       // brightness of unlit segments: 0 = off, try 10
#define FPS               50
#define DATE_DAY_PERCENT  50      // with auto-dimming off, date and day displays run at this % of the slider

Adafruit_NeoPixel stripTimeA(86,  PIN_TIME_A, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel stripTimeB(86,  PIN_TIME_B, NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel stripDate (105, PIN_DATE,   NEO_GRB + NEO_KHZ800);
Adafruit_NeoPixel stripDay  (78,  PIN_DAY,    NEO_GRB + NEO_KHZ800);

// ---------------- Other hardware / network ----------------
#define CLOCK_HOSTNAME    "RainbowWallClock"  // this clock's name: given to the router, used for http://rainbowwallclock.local,
                                              // as the Home Assistant device name and at the start of each network log
                                              // line. Give each clock its own name. Letters, digits and - only.
#define DISABLE_BATTERY_CHARGER true      // no LiPo fitted: turn the battery charger off, which stops the CHG LED flashing
const int pResistor = LIGHT_SENSOR_PIN;
#define RESET_HOLD_MS     3000            // hold the reset-settings button this long to clear the saved Wi-Fi details
RTC_DS3231 rtc;
unsigned int localPort = 2390;            // local port to listen for NTP replies
const int NTP_PACKET_SIZE = 48;
byte packetBuffer[NTP_PACKET_SIZE];
WiFiUDP Udp;
char ssid[] = "RainbowClockSetup";        // name of the setup network the clock creates
int status = WL_IDLE_STATUS;
WiFiServer server(80);
String readString;

// ---------------- Log: Serial Monitor, plus an optional copy to another computer ----------------
// Everything the sketch prints goes through Log (Log.print / Log.println work like Serial's). It always
// goes to the Serial Monitor. When "Network log" is set on the setup page, each finished line is also sent
// as one UDP message to that computer, e.g. to see it there run:  nc -kul 4210   (or use Packet Sender).
WiFiUDP logUdp;

class NetLog : public Print {
 public:
  IPAddress host;
  uint16_t port = 0;
  bool enabled = false;

  size_t write(uint8_t c) override {
    Serial.write(c);
    if (c == '\r') return 1;
    if (c == '\n') { sendLine(); return 1; }
    if (len >= sizeof(line)) sendLine();       // very long line: send it in pieces
    line[len++] = (char)c;
    return 1;
  }
  using Print::write;

 private:
  char line[160];
  size_t len = 0;

  void sendLine() {
    if (enabled && len > 0 && WiFi.status() == WL_CONNECTED) {
      logUdp.beginPacket(host, port);
      logUdp.write((const uint8_t *)"[" CLOCK_HOSTNAME "] ", strlen("[" CLOCK_HOSTNAME "] "));   // which clock it came from
      logUdp.write((const uint8_t *)line, len);
      logUdp.write('\n');
      logUdp.endPacket();
    }
    len = 0;
  }
};
NetLog Log;

// ================= TYPES =================
// All types live here, above the first function, because the Arduino IDE
// inserts function prototypes just before the first function in the file.

