// A segment as a line inside a character box 1 wide x 2 tall (y = 0 at top)
struct Line { float x0, y0, x1, y1; };

// ---- 7-segment ----
enum { S7_TOP, S7_TL, S7_BL, S7_BOT, S7_BR, S7_MID, S7_TR };
// Each line runs from the segment's FIRST wired LED to its last (board upright).
// Measured on the pin 10 display (upside down) and turned back upright.
const Line LINES7[7] = {
  {1, 0, 0, 0},   // top           right to left
  {0, 0, 0, 1},   // top-left      top to bottom
  {0, 1, 0, 2},   // bottom-left   top to bottom
  {0, 2, 1, 2},   // bottom        left to right
  {1, 2, 1, 1},   // bottom-right  bottom to top
  {1, 1, 0, 1},   // middle        right to left
  {1, 1, 1, 0}    // top-right     bottom to top
};
const uint8_t ROT7[7] = {S7_BOT, S7_BR, S7_TR, S7_TOP, S7_TL, S7_MID, S7_BL};

#define M7_TOP (1 << S7_TOP)
#define M7_TL  (1 << S7_TL)
#define M7_BL  (1 << S7_BL)
#define M7_BOT (1 << S7_BOT)
#define M7_BR  (1 << S7_BR)
#define M7_MID (1 << S7_MID)
#define M7_TR  (1 << S7_TR)

const uint16_t DIGIT7[10] = {
  M7_TOP | M7_TL | M7_BL | M7_BOT | M7_BR | M7_TR,           // 0
  M7_TR | M7_BR,                                             // 1
  M7_TOP | M7_TR | M7_MID | M7_BL | M7_BOT,                  // 2
  M7_TOP | M7_TR | M7_MID | M7_BR | M7_BOT,                  // 3
  M7_TL | M7_TR | M7_MID | M7_BR,                            // 4
  M7_TOP | M7_TL | M7_MID | M7_BR | M7_BOT,                  // 5
  M7_TOP | M7_TL | M7_BL | M7_BOT | M7_BR | M7_MID,          // 6
  M7_TOP | M7_TR | M7_BR,                                    // 7
  0x7F,                                                      // 8
  M7_TOP | M7_TL | M7_TR | M7_MID | M7_BR | M7_BOT           // 9
};

// ---- 13-segment ----
enum { S_K, S_L, S_M, S_E, S_H, S_I, S_J, S_G, S_F, S_A, S_B, S_C, S_D };
// Each line runs from the segment's FIRST wired LED to its second.
// Measured order: K2 K1, L1 L2, M2 M1, E2 E1, H1 H2, I2 I1, J1 J2,
//                 G2 G1, F2 F1, A1 A2, B1 B2, C1 C2, D2 D1
// (1 = top end, or left end for A, G and D)
const Line LINES13[13] = {
  {1, 2, 0.5, 1},     // K diagonal bottom right  (bottom end first)
  {0.5, 1, 0.5, 2},   // L centre bottom          (top first)
  {0, 2, 0.5, 1},     // M diagonal bottom left   (bottom end first)
  {0, 2, 0, 1},       // E bottom left            (bottom first)
  {0, 0, 0.5, 1},     // H diagonal top left      (top end first)
  {0.5, 1, 0.5, 0},   // I centre top             (bottom first)
  {1, 0, 0.5, 1},     // J diagonal top right     (top end first)
  {1, 1, 0, 1},       // G middle                 (right first)
  {0, 1, 0, 0},       // F top left               (bottom first)
  {0, 0, 1, 0},       // A top                    (left first)
  {1, 0, 1, 1},       // B top right              (top first)
  {1, 1, 1, 2},       // C bottom right           (top first)
  {1, 2, 0, 2}        // D bottom                 (right first)
};
// 180 degree rotation: A<->D, B<->E, C<->F, H<->K, I<->L, J<->M, G stays
const uint8_t ROT13[13] = {S_H, S_I, S_J, S_B, S_K, S_L, S_M, S_G, S_C, S_D, S_E, S_F, S_A};

#define SA (1 << S_A)
#define SB (1 << S_B)
#define SC (1 << S_C)
#define SD (1 << S_D)
#define SE (1 << S_E)
#define SF (1 << S_F)
#define SG (1 << S_G)
#define SH (1 << S_H)
#define SI (1 << S_I)
#define SJ (1 << S_J)
#define SK (1 << S_K)
#define SL (1 << S_L)
#define SM (1 << S_M)
// The middle bar (G) is two LEDs. A character can light just one of them:
#define SGL (1 << 13)   // left LED of the middle bar only
#define SGR (1 << 14)   // right LED of the middle bar only

const char *DAY_NAMES[7] = {"SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"};

