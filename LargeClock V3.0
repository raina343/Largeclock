            parseSettings(Buf);
            client.println("HTTP/1.1 200 OK");
            client.println("Content-Type: text/html");
            client.println();
            Log.println("Starting Wifi Check");

            String returnedip = validateSSID(owner);
            if (returnedip == "0.0.0.0") {
              Log.println("Wifi Failed");
              debugoutput(1, 0, 1, 0, 255, 0, 0);
              startSetupAP();
            } else {  // connection successful.  Top and bottow rows blue.
              WiFi.setHostname(CLOCK_HOSTNAME);
              status = WiFi.begin(owner.wifissid, owner.Password);
              debugoutput(1, 0, 1, 0, 0, 0, 255);
              owner.valid = true;
              owner.settingsMagic = SETTINGS_MAGIC;
              Log.println("Saving Data");
              my_flash_store.write(owner);
              delay(2000);
              NVIC_SystemReset();   // restart so the new settings take effect
              Log.println("Restarting Server");
              //              owner2 = my_flash_store.read();
              //              Log.println((String)owner2.temp);
              //              Log.println((String)owner2.valid);
            }
          }

          readString = "";
          // you're starting a new line

          currentLineIsBlank = true;
        } else if (c != '\r') {
          // you've gotten a character on the current line
          // Log.println("b");
          currentLineIsBlank = false;
        }
      }
    }

    delay(1);
    client.stop();


  } else {
    // Log.println ("Client is false");
  }
}

// ================= MESSAGES (from Home Assistant, or "msg" in the Serial Monitor) =================
// The date and day displays read as one 7-character line, date first. Up to 7 characters stay still;
// longer text scrolls (after a short pause at the start). After owner.msgSeconds the normal date and day return.
#define MSG_SCROLL_MS   350       // time per scroll step
#define MSG_START_MS    1500      // pause before a long message starts scrolling
#define MSG_GAP         3         // blank characters between the end of a scrolling message and its start

char msgText[65] = "";
bool msgActive = false;
unsigned long msgEndAt = 0, msgStepAt = 0;
int msgPos = 0;
bool msgStateDirty = false;       // tells MQTT to publish the message state

void drawMessageWindow() {
  int len = strlen(msgText);
  char win[7];
  for (int i = 0; i < 7; i++) {
    if (len <= 7) {
      win[i] = i < len ? msgText[i] : ' ';
    } else {
      int k = (msgPos + i) % (len + MSG_GAP);
      win[i] = k < len ? msgText[k] : ' ';
    }
  }
  char date[5] = {win[0], win[1], win[2], win[3], 0};
  char day[4] = {win[4], win[5], win[6], 0};
  writePanelText(panels[DATE_PANEL], date);
  writePanelText(panels[DAY_PANEL], day);
}

void endMessage() {
  msgActive = false;
  msgText[0] = 0;
  msgStateDirty = true;
  panels[DATE_PANEL].manual = false;
  panels[DAY_PANEL].manual = false;
  panels[DATE_PANEL].fadeMs = 0;
  panels[DAY_PANEL].fadeMs = 0;
  panels[DATE_PANEL].hideSep = false;
  writePanelText(panels[DATE_PANEL], "");
  writePanelText(panels[DAY_PANEL], "");
  if (inSetupMode) {
    setPanelText(DATE_PANEL, "SET");
    setPanelText(DAY_PANEL, "UP");
  }
  drawClock();   // date and day back (if the time is known)
}

// Show text for "seconds" (a long message always gets at least one full pass). Empty text clears it.
void showMessage(const char *text, unsigned long seconds) {
  while (*text == ' ') text++;
  if (!*text) {
    if (msgActive) {
      Log.println("Message cleared");
      endMessage();
    }
    return;
  }
  setText(msgText, sizeof(msgText), text);
  int len = strlen(msgText);
  unsigned long ms = seconds * 1000UL;
  if (len > 7) {
    unsigned long onePass = MSG_START_MS + (unsigned long)(len + MSG_GAP) * MSG_SCROLL_MS;
    if (ms < onePass) ms = onePass;
  }
  msgActive = true;
  msgStateDirty = true;
  msgPos = 0;
  msgEndAt = millis() + ms;
  msgStepAt = millis() + MSG_START_MS;
  panels[DATE_PANEL].manual = true;
  panels[DAY_PANEL].manual = true;
  panels[DATE_PANEL].hideSep = true;
  panels[DATE_PANEL].fadeMs = (len > 7) ? 120 : 0;   // quick fades so scrolling text stays readable
  panels[DAY_PANEL].fadeMs = (len > 7) ? 120 : 0;
  drawMessageWindow();
  Log.print("Message: ");
  Log.println(msgText);
}

void serialMessage(const char *text) {
  showMessage(text, owner.msgSeconds);
}

void updateMessage() {
  if (!msgActive) return;
  if ((long)(millis() - msgEndAt) >= 0) {
    endMessage();
    return;
  }
  int len = strlen(msgText);
  if (len > 7 && (long)(millis() - msgStepAt) >= 0) {
    msgPos = (msgPos + 1) % (len + MSG_GAP);
    msgStepAt = millis() + MSG_SCROLL_MS;
    drawMessageWindow();
  }
}

// ================= HOME ASSISTANT (MQTT) =================
// With a broker set on the setup page, the clock connects to it and announces itself using Home Assistant's
// MQTT discovery, so it shows up under Settings > Devices & services > MQTT as "Rainbow Clock" with:
//   Effect (Rotate or one effect), Current effect, Effect change, Message, Message seconds, Brightness,
//   Auto dimming, Temperature, Wi-Fi signal, Restart, and online/offline status.
// Changes made from Home Assistant last until the clock restarts (the setup page's settings apply at
// start-up), so automations can change things often without wearing out the settings flash.
// Topics: rainbowclock/<id>/<thing> for states and rainbowclock/<id>/<thing>/set for commands.
#define MQTT_RETRY_MS     120000UL   // if the broker can't be reached, try again this often
#define MQTT_STATS_MS     60000UL    // how often temperature and Wi-Fi signal are sent

WiFiClient mqttNet;
MqttClient mqtt(mqttNet);
String mqttId;                       // e.g. "rainbowclock_a1b2c3" (from the Wi-Fi MAC address)
String mqttBase;                     // e.g. "rainbowclock/a1b2c3"
unsigned long mqttLastTry = 0;
bool mqttTried = false;
bool mqttAnnounce = false;           // (re)send discovery + all states on the next loop

// What was last sent, so only changes are published
int pubStyle = -2;
int pubAuto = -1;
int pubInterval = -1;
int pubBright = -1;
int pubDimming = -1;
int pubMsgSecs = -1;
int pubUnsaved = -1;
unsigned long pubStatsAt = 0;

bool mqttEnabled() {
  return owner.mqttHost[0] != 0;
}

bool mqttConnected() {
  return mqtt.connected();
}

void mqttPublish(const String &topic, const String &payload, bool retain) {
  mqtt.beginMessage(topic, payload.length(), retain, 0);
  mqtt.print(payload);
  mqtt.endMessage();
}

// One Home Assistant discovery message. "body" is the entity-specific part of the JSON.
void mqttDiscover(const char *component, const char *object, const String &body) {
  String topic = String("homeassistant/") + component + "/" + mqttId + "/" + object + "/config";
  String json = "{\"~\":\"" + mqttBase + "\"," + body +
                ",\"uniq_id\":\"" + mqttId + "_" + object + "\"" +
                ",\"avty_t\":\"~/status\"" +
                ",\"dev\":{\"ids\":[\"" + mqttId + "\"],\"name\":\"" + CLOCK_HOSTNAME + "\",\"mf\":\"DIY\",\"mdl\":\"Arduino MKR WiFi 1010\"" +
                ",\"cu\":\"" + clockWebAddress() + "\"}}";      // "Visit" link on the device page
  mqttPublish(topic, json, true);
}

String jsonList(const char *first, const char *const *items, int count) {
  String s = "[";
  if (first) s += String("\"") + first + "\"";
  for (int i = 0; i < count; i++) {
    if (s.length() > 1) s += ",";
    s += String("\"") + items[i] + "\"";
  }
  return s + "]";
}

void mqttSendDiscovery() {
  mqttDiscover("select", "effect",
               "\"name\":\"Effect\",\"icon\":\"mdi:palette\",\"cmd_t\":\"~/effect/set\",\"stat_t\":\"~/effect\",\"ops\":" +
               jsonList("Rotate", STYLE_NAMES, NUM_STYLES));
  mqttDiscover("sensor", "current_effect",
               "\"name\":\"Current effect\",\"icon\":\"mdi:palette-outline\",\"stat_t\":\"~/current_effect\"");
  mqttDiscover("select", "interval",
               "\"name\":\"Effect change\",\"icon\":\"mdi:timer-sync\",\"cmd_t\":\"~/interval/set\",\"stat_t\":\"~/interval\",\"ops\":" +
               jsonList(NULL, FX_PERIOD_NAMES, FX_PERIOD_COUNT));
  mqttDiscover("text", "message",
               "\"name\":\"Message\",\"icon\":\"mdi:message-text\",\"cmd_t\":\"~/message/set\",\"stat_t\":\"~/message\",\"max\":64");
  mqttDiscover("number", "message_seconds",
               "\"name\":\"Message seconds\",\"icon\":\"mdi:timer-outline\",\"cmd_t\":\"~/message_seconds/set\",\"stat_t\":\"~/message_seconds\","
               "\"min\":3,\"max\":3600,\"step\":1,\"mode\":\"box\",\"unit_of_meas\":\"s\",\"ent_cat\":\"config\"");
  mqttDiscover("number", "brightness",
               "\"name\":\"Brightness\",\"icon\":\"mdi:brightness-6\",\"cmd_t\":\"~/brightness/set\",\"stat_t\":\"~/brightness\","
               "\"min\":1,\"max\":255,\"step\":1,\"mode\":\"slider\"");
  mqttDiscover("switch", "auto_dimming",
               "\"name\":\"Auto dimming\",\"icon\":\"mdi:brightness-auto\",\"cmd_t\":\"~/auto_dimming/set\",\"stat_t\":\"~/auto_dimming\"");
  mqttDiscover("sensor", "temperature",
               String("\"name\":\"Temperature\",\"dev_cla\":\"temperature\",\"stat_cla\":\"measurement\",\"stat_t\":\"~/temperature\",\"unit_of_meas\":\"") +
               (tempInF ? "\xC2\xB0" "F" : "\xC2\xB0" "C") + "\"");
  mqttDiscover("sensor", "wifi_signal",
               "\"name\":\"Wi-Fi signal\",\"dev_cla\":\"signal_strength\",\"stat_cla\":\"measurement\",\"stat_t\":\"~/wifi_signal\","
               "\"unit_of_meas\":\"dBm\",\"ent_cat\":\"diagnostic\"");
  mqttDiscover("sensor", "last_sync",
               "\"name\":\"Last time sync\",\"dev_cla\":\"timestamp\",\"icon\":\"mdi:clock-check\",\"stat_t\":\"~/last_sync\"");
  mqttDiscover("sensor", "sync_result",
               "\"name\":\"Time sync result\",\"icon\":\"mdi:clock-alert-outline\",\"stat_t\":\"~/sync_result\"");
  mqttDiscover("sensor", "clock_drift",
               "\"name\":\"Clock drift\",\"icon\":\"mdi:clock-fast\",\"stat_t\":\"~/clock_drift\",\"unit_of_meas\":\"s\",\"stat_cla\":\"measurement\"");
  mqttDiscover("sensor", "web_address",
               "\"name\":\"Web address\",\"icon\":\"mdi:web\",\"stat_t\":\"~/web_address\",\"ent_cat\":\"diagnostic\"");
  mqttDiscover("sensor", "ip_address",
               "\"name\":\"IP address\",\"icon\":\"mdi:ip-network\",\"stat_t\":\"~/ip_address\",\"ent_cat\":\"diagnostic\"");
  mqttDiscover("button", "restart",
               "\"name\":\"Restart\",\"dev_cla\":\"restart\",\"cmd_t\":\"~/restart/set\",\"ent_cat\":\"config\"");
  mqttDiscover("button", "save",
               "\"name\":\"Save settings\",\"icon\":\"mdi:content-save\",\"cmd_t\":\"~/save/set\"");
  mqttDiscover("button", "revert",
               "\"name\":\"Revert to saved\",\"icon\":\"mdi:restore\",\"cmd_t\":\"~/revert/set\"");
  mqttDiscover("binary_sensor", "unsaved",
               "\"name\":\"Unsaved changes\",\"icon\":\"mdi:content-save-alert\",\"stat_t\":\"~/unsaved\"");
}

// Publish anything that has changed since it was last sent (or everything, when force is true).
void mqttSendStates(bool force) {
  if (force || currentStyle != pubStyle || (int)autoStyle != pubAuto) {
    mqttPublish(mqttBase + "/effect", autoStyle ? "Rotate" : STYLE_NAMES[currentStyle], true);
    mqttPublish(mqttBase + "/current_effect", STYLE_NAMES[currentStyle], true);
    pubStyle = currentStyle;
    pubAuto = autoStyle;
  }
  if (force || owner.fxInterval != pubInterval) {
    mqttPublish(mqttBase + "/interval", FX_PERIOD_NAMES[owner.fxInterval], true);
    pubInterval = owner.fxInterval;
  }
  int bright = constrain(atoi(owner.brightness), 1, 255);
  if (force || bright != pubBright) {
    mqttPublish(mqttBase + "/brightness", String(bright), true);
    pubBright = bright;
  }
  if (force || (int)autoDimming != pubDimming) {
    mqttPublish(mqttBase + "/auto_dimming", autoDimming ? "ON" : "OFF", true);
    pubDimming = autoDimming;
  }
  if (force || owner.msgSeconds != pubMsgSecs) {
    mqttPublish(mqttBase + "/message_seconds", String(owner.msgSeconds), true);
    pubMsgSecs = owner.msgSeconds;
  }
  if ((force || syncStateDirty) && syncResultText[0]) {
    mqttPublish(mqttBase + "/sync_result", syncResultText, true);
    if (lastSyncUtc) {
      char iso[32];
      snprintf(iso, sizeof(iso), "%04d-%02d-%02dT%02d:%02d:%02d+00:00", year(lastSyncUtc), month(lastSyncUtc),
               day(lastSyncUtc), hour(lastSyncUtc), minute(lastSyncUtc), second(lastSyncUtc));
      mqttPublish(mqttBase + "/last_sync", iso, true);
      mqttPublish(mqttBase + "/clock_drift", String(lastSyncDrift), true);
    }
    syncStateDirty = false;
  }
  int unsaved = unsavedChanges();
  if (force || unsaved != pubUnsaved) {
    mqttPublish(mqttBase + "/unsaved", unsaved ? "ON" : "OFF", true);
    pubUnsaved = unsaved;
  }
  if (force || msgStateDirty) {
    mqttPublish(mqttBase + "/message", msgActive ? msgText : "", true);
    msgStateDirty = false;
  }
  if (force) {
    mqttPublish(mqttBase + "/web_address", clockWebAddress(), true);
    IPAddress ip = WiFi.localIP();
    mqttPublish(mqttBase + "/ip_address", String(ip[0]) + "." + ip[1] + "." + ip[2] + "." + ip[3], true);
  }
  if (force || millis() - pubStatsAt >= MQTT_STATS_MS) {
    pubStatsAt = millis();
    if (rtcOk || usingDs18()) mqttPublish(mqttBase + "/temperature", String(shownTemperature(), 1), true);
    mqttPublish(mqttBase + "/wifi_signal", String(WiFi.RSSI()), true);
  }
}

int findName(const char *name, const char *const *list, int count) {
  for (int i = 0; i < count; i++)
    if (!strcasecmp(name, list[i])) return i;
  return -1;
}

// A command from Home Assistant.
void onMqttMessage(int size) {
  (void)size;                                       // the payload is read until it runs out
  String topic = mqtt.messageTopic();
  char val[80];
  int n = 0;
  while (mqtt.available()) {
    int c = mqtt.read();
    if (n < (int)sizeof(val) - 1) val[n++] = (char)c;
  }
  val[n] = 0;

  if (topic == "homeassistant/status") {            // Home Assistant restarted: announce again
    if (!strcmp(val, "online")) mqttAnnounce = true;
    return;
  }
  if (!topic.startsWith(mqttBase + "/") || !topic.endsWith("/set")) return;
  String what = topic.substring(mqttBase.length() + 1, topic.length() - 4);
  Log.print("Home Assistant: ");
  Log.print(what);
  Log.print(" = ");
  Log.println(val);

  if (what == "effect") {
    if (!strcasecmp(val, "Rotate")) {
      autoStyle = true;
      if (rtcOk && timeValid) updateEffect(tzMain.toLocal(rtc.now().unixtime()));
    } else {
      int i = findName(val, STYLE_NAMES, NUM_STYLES);
      if (i >= 0) {
        autoStyle = false;
        setStyle(i);
      }
    }
  } else if (what == "interval") {
    int i = findName(val, FX_PERIOD_NAMES, FX_PERIOD_COUNT);
    if (i >= 0) {
      owner.fxInterval = i;
      if (autoStyle && rtcOk && timeValid) updateEffect(tzMain.toLocal(rtc.now().unixtime()));
    }
  } else if (what == "message") {
    showMessage(val, owner.msgSeconds);
    msgStateDirty = true;
  } else if (what == "message_seconds") {
    owner.msgSeconds = constrain(atoi(val), 3, 3600);
  } else if (what == "brightness") {
    snprintf(owner.brightness, sizeof(owner.brightness), "%d", constrain(atoi(val), 1, 255));
    autoDimming = false;                            // a fixed brightness only makes sense with auto-dimming off
    setText(owner.dimmer, sizeof(owner.dimmer), "of");
    applyBrightness();
  } else if (what == "auto_dimming") {
    autoDimming = !strcasecmp(val, "ON");
    setText(owner.dimmer, sizeof(owner.dimmer), autoDimming ? "on" : "of");
    applyBrightness();
  } else if (what == "save") {
    saveSettingsNow();
  } else if (what == "revert") {
    revertToSaved();
  } else if (what == "restart") {
    mqttPublish(mqttBase + "/status", "offline", true);
    delay(200);
    NVIC_SystemReset();
  }
  mqttSendStates(false);                            // confirm the new state straight away
}

bool mqttConnect() {
  IPAddress ip;
  if (!ip.fromString(owner.mqttHost) && WiFi.hostByName(owner.mqttHost, ip) != 1) {
    Log.print("MQTT: can't find the broker ");
    Log.println(owner.mqttHost);
    return false;
  }
  if (mqttId.length() == 0) {
    byte mac[6];
    WiFi.macAddress(mac);                           // WiFiNINA gives the bytes last-first
    char id[7];
    snprintf(id, sizeof(id), "%02x%02x%02x", mac[2], mac[1], mac[0]);
    mqttId = String("rainbowclock_") + id;
    mqttBase = String("rainbowclock/") + id;
  }
  mqtt.setId(mqttId);
  if (owner.mqttUser[0]) mqtt.setUsernamePassword(owner.mqttUser, owner.mqttPass);
  mqtt.setKeepAliveInterval(60 * 1000L);
  mqtt.setConnectionTimeout(5000);
  String will = mqttBase + "/status";
  mqtt.beginWill(will, (unsigned short)strlen("offline"), true, 1);   // broker marks us offline if we vanish
  mqtt.print("offline");
  mqtt.endWill();

  Log.print("MQTT: connecting to ");
  Log.print(ip);
  Log.print(":");
  Log.println(owner.mqttPort);
  if (!mqtt.connect(ip, owner.mqttPort)) {
    int err = mqtt.connectError();
    Log.print("MQTT: connection failed (");
    Log.print(err);
    Log.println(err == 4 || err == 5 ? ": wrong username or password)" : ")");
    return false;
  }
  mqtt.onMessage(onMqttMessage);
  mqtt.subscribe(mqttBase + "/+/set");
  mqtt.subscribe("homeassistant/status");
  mqttPublish(mqttBase + "/status", "online", true);
  mqttAnnounce = true;
  Log.println("MQTT: connected - the clock should appear in Home Assistant");
  return true;
}

// Called every loop.
void mqttLoop() {
  if (!mqttEnabled() || inSetupMode || WiFi.status() != WL_CONNECTED) return;
  if (!mqtt.connected()) {
    if (mqttTried && millis() - mqttLastTry < MQTT_RETRY_MS) return;
    mqttTried = true;
    mqttLastTry = millis();
    mqttConnect();
    return;
  }
  mqtt.poll();
  if (mqttAnnounce) {
    mqttAnnounce = false;
    mqttSendDiscovery();
    mqttSendStates(true);
  } else {
    mqttSendStates(false);
  }
}

// Setup-page card: the broker to connect to.
void printMqttCard(WiFiClient &client) {
  client.println("<li class='a-mqtt'><fieldset class='card'><legend>Home Assistant (MQTT)</legend>");
  client.print("<p class='hint'>Leave the broker blank to turn this off. Use Home Assistant's IP address (.local names may not work). Status: ");
  if (!mqttEnabled()) client.print("off");
  else if (mqtt.connected()) client.print("<b>connected</b>");
  else client.print("<b>not connected</b> (see the network log)");
  client.println(".</p>");
  client.println("<div class='pairs'><div>");
  client.println("<label for='mqtthost'>Broker (IP address or name)</label>");
  client.print("<input id='mqtthost' type='text' value='");
  printAttr(client, owner.mqttHost);
  client.println("' placeholder='e.g. 192.168.1.20'>");
  client.println("</div><div class='narrow'>");
  client.println("<label for='mqttport'>Port</label>");
  client.print("<input id='mqttport' type='number' min='1' max='65535' value='");
  client.print(owner.mqttPort);
  client.println("'>");
  client.println("</div></div>");
  client.println("<div class='pairs'><div>");
  client.println("<label for='mqttuser'>Username</label>");
  client.print("<input id='mqttuser' type='text' autocomplete='off' value='");
  printAttr(client, owner.mqttUser);
  client.println("'>");
  client.println("</div><div>");
  client.println("<label for='mqttpass'>Password</label>");
  client.print("<div class='pwwrap'><input id='mqttpass' type='password' autocomplete='new-password' value='");
  printAttr(client, owner.mqttPass);
  client.println("'>");
  client.println("<button type='button' class='pwbtn' onclick=\"pwToggle('mqttpass', this)\">Show</button></div>");
  client.println("</div></div>");
  client.println("</fieldset></li>");
}

// ================= MDNS: http://rainbowclock.local =================
// Answers ".local" name lookups on the home network (the same trick Home Assistant uses for
// homeassistant.local), so the setup page can be opened at http://rainbowclock.local without knowing the IP
// address. Also advertises the web page as a service, so network browsers list "Rainbow Clock".
WiFiUDP mdnsUdp;
MDNS mdns(mdnsUdp);
bool mdnsRunning = false;

// CLOCK_HOSTNAME in lower case, e.g. "rainbowwallclock" (its .local name without the ".local")
const char *clockLocalName() {
  static char name[33] = "";
  if (!name[0]) {
    int n = 0;
    for (const char *c = CLOCK_HOSTNAME; *c && n < (int)sizeof(name) - 1; c++) name[n++] = tolower(*c);
    name[n] = 0;
  }
  return name;
}

// "http://rainbowwallclock.local"
String clockWebAddress() {
  return String("http://") + clockLocalName() + ".local";
}

void startMdns() {
  const char *mdnsName = clockLocalName();
  if (mdns.begin(WiFi.localIP(), mdnsName)) {
    String service = String(CLOCK_HOSTNAME) + "._http";
    mdns.addServiceRecord(service.c_str(), 80, MDNSServiceTCP);
    mdnsRunning = true;
    Log.print("mDNS: setup page also at http://");
    Log.print(mdnsName);
    Log.println(".local");
  } else {
    mdnsRunning = false;
    Log.println("mDNS: couldn't start (the .local name won't work; use the IP address)");
  }
}

void restartMdns() {     // after rejoining the Wi-Fi (the IP address may have changed)
  mdnsUdp.stop();
  startMdns();
}

void mdnsLoop() {
  if (mdnsRunning && !inSetupMode && WiFi.status() == WL_CONNECTED) mdns.run();
}

// ================= TEMPORARY CHANGES, SAVE AND REVERT =================
// Changes from Home Assistant (effect, effect change, brightness, auto-dimming, message seconds) only change
// the clock's memory. "Save settings" writes them to flash; "Revert to saved" goes back to what's in flash.
// savedSettings is a copy of what's in flash, used to tell whether anything is unsaved.
Credentials savedSettings;

int currentFixedEffect() {
  return autoStyle ? -1 : currentStyle;
}

// Use the saved effect choice: rotate, or hold one effect.
void applySavedEffect() {
  if (owner.fxFixed >= 0) {
    autoStyle = false;
    setStyle(owner.fxFixed);
  } else {
    autoStyle = true;
    if (rtcOk && timeValid) updateEffect(tzMain.toLocal(rtc.now().unixtime()));
  }
}

bool unsavedChanges() {
  return currentFixedEffect() != savedSettings.fxFixed ||
         owner.fxInterval != savedSettings.fxInterval ||
         strcmp(owner.brightness, savedSettings.brightness) != 0 ||
         strcmp(owner.dimmer, savedSettings.dimmer) != 0 ||
         owner.msgSeconds != savedSettings.msgSeconds;
}

void saveSettingsNow() {
  owner.fxFixed = currentFixedEffect();
  setText(owner.dimmer, sizeof(owner.dimmer), autoDimming ? "on" : "of");
  if (!unsavedChanges()) {
    Log.println("Settings: nothing to save");
    return;
  }
  my_flash_store.write(owner);
  savedSettings = owner;
  Log.println("Settings saved to flash");
}

void revertToSaved() {
  owner = my_flash_store.read();
  loadSettings();
  savedSettings = owner;
  applySavedEffect();
  applyBrightness();
  Log.println("Settings: back to the saved ones");
}

// ================= BATTERY CHARGER CHIP (BQ24195L) =================
// The MKR WiFi 1010's charger chip sits on the same I2C bus as the DS3231 (address 0x6B). With no LiPo fitted it
// keeps hunting for one and blinks the orange CHG LED. Switching charging off (and the chip's watchdog and
// safety timer, either of which can otherwise turn charging back on or cause the blinking) stops that.
// It's talked to directly here, so no extra library is needed. Type "pmic" in the Serial Monitor for its status.
#define PMIC_ADDR 0x6B

int pmicRead(uint8_t reg) {
  Wire.beginTransmission(PMIC_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission() != 0) return -1;
  if (Wire.requestFrom(PMIC_ADDR, 1) != 1) return -1;
  return Wire.read();
}

bool pmicWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(PMIC_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return Wire.endTransmission() == 0;
}

// Charging, watchdog and safety timer off; returns true if the chip confirms it.
bool chargerOff() {
  int r5 = pmicRead(0x05);                       // REG05: charge termination / timer control
  int r1 = pmicRead(0x01);                       // REG01: power-on configuration
  if (r5 < 0 || r1 < 0) {
    Log.println("Battery charger: chip not answering on I2C");
    return false;
  }
  pmicWrite(0x05, r5 & ~0x38);                   // WATCHDOG bits 5:4 = 00 (off), EN_TIMER bit 3 = 0 (safety timer off)
  pmicWrite(0x01, r1 & ~0x30 & 0x7F);            // CHG_CONFIG bits 5:4 = 00 (charging off); never set bit 7 (register reset)
  int c5 = pmicRead(0x05), c1 = pmicRead(0x01);
  bool ok = c5 >= 0 && c1 >= 0 && (c5 & 0x38) == 0 && (c1 & 0x30) == 0;
  Log.println(ok ? "Battery charger: off (no battery fitted) - CHG LED should stop flashing"
                 : "Battery charger: tried to switch it off but the chip didn't take the change");
  return ok;
}

// Plain-words status of the charger chip.
void logChargerStatus() {
  int r1 = pmicRead(0x01), r5 = pmicRead(0x05), r8 = pmicRead(0x08);
  pmicRead(0x09);                                // the first read returns faults latched since the last read...
  int r9 = pmicRead(0x09);                       // ...the second the faults present now
  if (r1 < 0 || r5 < 0 || r8 < 0 || r9 < 0) {
    Log.println("Battery charger: chip not answering on I2C");
    return;
  }
  static const char *chg[] = {"not charging", "pre-charging", "fast charging", "charge done"};
  static const char *vbus[] = {"no input", "USB host", "adapter", "OTG"};
  static const char *flt[] = {"none", "input fault", "thermal shutdown", "safety timer expired"};
  Log.print("Battery charger: charging ");
  Log.print((r1 & 0x30) == 0 ? "OFF" : "ON");
  Log.print(", watchdog ");
  Log.print((r5 & 0x30) == 0 ? "off" : "ON");
  Log.print(", safety timer ");
  Log.print((r5 & 0x08) ? "ON" : "off");
  Log.print(" | status: ");
  Log.print(chg[(r8 >> 4) & 3]);
  Log.print(", power from ");
  Log.print(vbus[(r8 >> 6) & 3]);
  Log.print((r8 & 0x04) ? ", power good" : ", power NOT good");
  Log.print(" | faults: charge ");
  Log.print(flt[(r9 >> 4) & 3]);
  if (r9 & 0x80) Log.print(", watchdog expired");
  if (r9 & 0x08) Log.print(", battery over-voltage");
  if (r9 & 0x07) { Log.print(", temperature sensor fault "); Log.print(r9 & 0x07); }
  Log.print(" (raw REG01=0x"); Log.print(r1, HEX);
  Log.print(" REG05=0x"); Log.print(r5, HEX);
  Log.print(" REG08=0x"); Log.print(r8, HEX);
  Log.print(" REG09=0x"); Log.print(r9, HEX);
  Log.println(")");
}

// Once a minute: if charging has been switched back on (e.g. the chip reset itself), switch it off again.
void checkChargerStillOff() {
#if DISABLE_BATTERY_CHARGER
  int r1 = pmicRead(0x01);
  if (r1 >= 0 && (r1 & 0x30) != 0) {
    Log.println("Battery charger: charging had come back on - switching it off again");
    chargerOff();
    logChargerStatus();
  }
#endif
}

// ================= RESET-SETTINGS BUTTON =================
// Hold the button on RESET_BUTTON_PIN for RESET_HOLD_MS (3 s): the saved Wi-Fi network and password are
// cleared and the clock restarts into its "RainbowClockSetup" network. Timezones, effects and the other
// settings are kept. While it's held, the date display shows "CLR" and the day display counts down; let go
// before the end and nothing changes. A button that already reads pressed at start-up is ignored until it has
// been released once, so a stuck button or wiring fault can never cause a clear-and-restart loop.
void checkResetButton() {
  static unsigned long pressedAt = 0;
  static int shownLeft = -1;
  static bool armed = false;      // only true once the button has been seen released since start-up
  static bool warned = false;
  if (!armed) {
    if (digitalRead(RESET_BUTTON_PIN) == HIGH) {
      armed = true;
      if (warned) Log.println("Reset button: released, now working normally");
    } else if (!warned) {
      warned = true;
      Log.print("Reset button: pin ");
      Log.print(RESET_BUTTON_PIN);
      Log.println(" reads PRESSED at start-up - ignoring it until it's released (check the button wiring)");
    }
    return;
  }
  if (digitalRead(RESET_BUTTON_PIN) == HIGH) {          // not pressed (the pin's pull-up holds it high)
    if (shownLeft >= 0) {                               // let go early: put the normal displays back
      Log.println("Reset button released - nothing changed");
      panels[DAY_PANEL].manual = false;
      panels[DATE_PANEL].manual = false;
      writePanelText(panels[DAY_PANEL], "");
      writePanelText(panels[DATE_PANEL], "");
      if (inSetupMode) {
        setPanelText(DATE_PANEL, "SET");   // date display reads first
        setPanelText(DAY_PANEL, "UP");
      }
      drawClock();                                      // puts the date and day back (if the time is known)
    }
    pressedAt = 0;
    shownLeft = -1;
    return;
  }
  if (pressedAt == 0) {
    pressedAt = millis();
    return;
  }
  unsigned long held = millis() - pressedAt;
  if (held < 300) return;                               // ignore bounces and accidental taps

  int left = (RESET_HOLD_MS - min(held, (unsigned long)RESET_HOLD_MS) + 999) / 1000;   // whole seconds left
  if (left != shownLeft) {
    if (shownLeft < 0) Log.println("Reset button held: keep holding to clear the Wi-Fi settings");
    shownLeft = left;
    char buf[6];
    snprintf(buf, sizeof(buf), " %d", left);
    panels[DAY_PANEL].manual = true;
    panels[DATE_PANEL].manual = true;
    writePanelText(panels[DATE_PANEL], "CLR");          // reads "CLR 3", "CLR 2", ...
    writePanelText(panels[DAY_PANEL], buf);
  }
  if (held < RESET_HOLD_MS) return;

  Log.println("Clearing the saved Wi-Fi settings and restarting into the setup network");
  owner.valid = false;
  memset(owner.wifissid, 0, sizeof(owner.wifissid));
  memset(owner.Password, 0, sizeof(owner.Password));
  my_flash_store.write(owner);
  writePanelText(panels[DATE_PANEL], "WIFI");         // reads "WIFI CLR"
  writePanelText(panels[DAY_PANEL], "CLR");
  unsigned long t = millis();
  while (millis() - t < 1500) clockUpdate();            // show it for a moment
  NVIC_SystemReset();
}

// ================= SETUP / LOOP =================
// Why the board last restarted (SAMD21 reset-cause register), printed at start-up to help diagnose problems.
const char *resetCause() {
  uint8_t r = PM->RCAUSE.reg;
  if (r & PM_RCAUSE_SYST) return "software restart (e.g. after saving settings)";
  if (r & PM_RCAUSE_WDT)  return "watchdog";
  if (r & PM_RCAUSE_EXT)  return "reset pin (button, or something pulling RESET low)";
  if (r & PM_RCAUSE_BOD33 || r & PM_RCAUSE_BOD12) return "power dipped too low (brown-out)";
  if (r & PM_RCAUSE_POR)  return "power on";
  return "unknown";
}

void setup() {
  pinMode(RESET_WIRE_PIN, INPUT);   // high-impedance: the pin is wired to RESET, so it must never be driven
  pinMode(RESET_BUTTON_PIN, INPUT);          // reset-settings button pulls this to GND when pressed;
  digitalWrite(RESET_BUTTON_PIN, HIGH);      // on an input, HIGH turns the pull-up on (same as INPUT_PULLUP)
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, HIGH);           // built-in LED on while starting up
  Serial.begin(115200);
  unsigned long waitStart = millis();
  while (!Serial && millis() - waitStart < 2000);   // give the Serial Monitor a moment to connect
  Log.println();
  Log.println("==== Rainbow Clock starting ====");
  Log.print("Name: ");
  Log.print(CLOCK_HOSTNAME);
  Log.print(" (setup page: ");
  Log.print(clockWebAddress());
  Log.println(" once on the Wi-Fi)");
  Log.print("Last restart: ");
  Log.println(resetCause());
  Log.print("Reset button (pin ");
  Log.print(RESET_BUTTON_PIN);
  Log.println(digitalRead(RESET_BUTTON_PIN) == HIGH ? "): not pressed" : "): reads PRESSED");
  buildSinTable();
  Log.println("Starting LED displays...");
  setupAllPanels();
  Log.println("LED displays ok");
  randomSeed(analogRead(pResistor));

  owner = my_flash_store.read();
  loadSettings();
  savedSettings = owner;
  setStyle(0);
  if (owner.fxFixed >= 0) {          // saved as "hold one effect"
    autoStyle = false;
    setStyle(owner.fxFixed);
  }

  rtcOk = rtc.begin();
  Log.println(rtcOk ? "RTC (DS3231) found" : "RTC (DS3231) not found");
  Wire.begin();
#if DISABLE_BATTERY_CHARGER
  chargerOff();
#endif
  logChargerStatus();
  setupDs18();
  if (rtcOk) {
    timeValid = !rtc.lostPower();   // the RTC kept time on its battery
    Log.print("RTC at start-up: ");
    logDateTime(rtc.now().unixtime());
    Log.println(timeValid ? " UTC" : " UTC - but it lost power, so this isn't trusted until the time server answers");
    setupRtcAlarms();
  }

  Log.println("Checking Wi-Fi module...");
  if (WiFi.status() == WL_NO_MODULE) {
    debugoutput(1, 0, 0, 0, 255, 0, 0);       // top row red: no Wi-Fi module
    Log.println("Communication with WiFi module failed!");
    while (true);
  }
  String fv = WiFi.firmwareVersion();
  Log.print("Wi-Fi module firmware ");
  Log.println(fv);
  if (fv < WIFI_FIRMWARE_LATEST_VERSION) Log.println("Please upgrade the WiFi firmware");

  int ntpResult = 2;
  if (!owner.valid) {
    Log.println("No saved Wi-Fi settings: starting the setup network");
    startSetupAP();
  } else {
    debugoutput(0, 1, 0, 0, 0, 150, 0);       // middle row green: connecting with saved details
    Log.print("Stored SSID: ");
    Log.println(owner.wifissid);
    String returnedip = validateSSID(owner);
    if (returnedip == "0.0.0.0") {
      debugoutput(1, 1, 1, 0, 255, 0, 0);     // all rows red: couldn't join the saved Wi-Fi
      Log.println("Wifi Failed");
      delay(3000);
      startSetupAP();
      if (rtcOk) nextWifiTry = rtc.now().unixtime() + WIFI_RETRY_MINUTES * 60UL;   // try the saved Wi-Fi again later
    } else {
      debugoutput(0, 0, 1, 1, 0, 150, 0);     // bottom row + colon green: joined the Wi-Fi
      WiFi.noLowPowerMode();                  // keep the radio awake so it answers promptly
      server.begin();
      startNetLog();
      startMdns();
      printWiFiStatus();
      if (rtcOk) {
        ntpResult = syncTimeFromNTP();
        if (ntpResult == 1) { debugoutput(1, 1, 1, 0, 150, 150, 150); delay(3000); }   // grey: DNS failed
        if (ntpResult == 2) { debugoutput(1, 1, 1, 0, 255, 75, 250);  delay(3000); }   // pink: no reply
      }
    }
  }
  if (rtcOk && ntpResult != 0) ntpRetryAt = rtc.now().unixtime() + 3600UL;   // boot sync failed: retry hourly

  if (!timeValid) {   // no believable time yet: dashes until the time server answers
    writePanelText(panels[TIME_A_PANEL], "----");
    writePanelText(panels[TIME_B_PANEL], "----");
  }
  drawClock();        // show the time now rather than waiting for the next minute alarm
  if (!inSetupMode) digitalWrite(LED_BUILTIN, LOW);   // started normally: built-in LED off
  Log.println("Clock ready - type help in the Serial Monitor for test commands");
}

void loop() {
  handleRtcAlarms();    // DS3231 alarms: :00 time / date / effect, :55 temperature
  checkMissedAlarms();  // safety net if an alarm doesn't arrive (logs a warning)
  updateBrightness();   // light sensor or fixed brightness
  clockUpdate();        // Serial Monitor commands + draw all displays at FPS
  handleWebClient();    // setup page
  checkResetButton();   // hold 3 s to clear the saved Wi-Fi details
  updateMessage();      // scroll / end a message on the date and day displays
  mqttLoop();           // Home Assistant
  mdnsLoop();           // answer rainbowclock.local lookups
}
