  // effect memory
  uint8_t heat[MAX_LEDS], glint[MAX_LEDS], jOffset[MAX_LEDS], jSpeed[MAX_LEDS];
  bool styleInit;
  bool hourShowActive;
  bool manual;                          // showing a value typed in the Serial Monitor
  bool flipFire;                        // Fire and Matrix rain upside down on this panel
  uint16_t fadeMs;                      // 0 = FADE_MS; shorter while a message scrolls
  bool hideSep;                         // turn the colon / dot off (date dot while showing temperature)
  uint8_t brightness;                   // set by updateBrightness()
  int16_t dropY[16];                    // Matrix rain drops
  uint8_t dropSpd[16];
  int8_t  burstSlot;                    // Fireworks
